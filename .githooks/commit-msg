#!/usr/bin/env bash
# Enforce tally commit hygiene: subject convention + no AI attribution.
# Args: $1 = commit message file
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  echo "commit-msg: missing message file" >&2
  exit 1
fi

subject="$(sed -n '1p' "$msg_file" | tr -d '\r')"

# Allow merge/revert subjects git generates
if [[ "$subject" =~ ^Merge\  ]] || [[ "$subject" =~ ^Revert\  ]]; then
  :
else
  # Project convention: type: lowercase narrative phrase (no scope, no trailing period)
  if ! [[ "$subject" =~ ^(feat|fix|docs|test|chore|refactor|perf|build|ci|style):\ [a-z].+ ]]; then
    echo "commit-msg: subject must match 'type: lowercase narrative phrase'" >&2
    echo "  allowed types: feat fix docs test chore refactor perf build ci style" >&2
    echo "  got: $subject" >&2
    exit 1
  fi
  if [[ "$subject" =~ \.$ ]]; then
    echo "commit-msg: subject must not end with a period" >&2
    echo "  got: $subject" >&2
    exit 1
  fi
fi

if grep -Eiq \
  -e '^[[:space:]]*Co-authored-by:[[:space:]].*(Cursor|cursoragent@)' \
  -e '^[[:space:]]*Made-with:[[:space:]]*Cursor' \
  -e '^[[:space:]]*Made with Cursor' \
  -e '^[[:space:]]*Generated by[[:space:]].*(Cursor|Claude|Copilot|ChatGPT)' \
  -e '^[[:space:]]*Generated with[[:space:]].*(Cursor|Claude|Copilot|ChatGPT)' \
  "$msg_file"; then
  echo "commit-msg: AI/tooling attribution trailers are forbidden in this repo" >&2
  echo "  remove Co-authored-by / Generated with / Made with Cursor lines" >&2
  exit 1
fi

exit 0
