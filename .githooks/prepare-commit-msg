#!/usr/bin/env bash
# Strip AI/tooling attribution trailers Cursor (and similar) may inject.
# Args: $1 = commit message file, $2 = source, $3 = SHA (optional)
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

# portable in-place edit without requiring GNU sed
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

grep -Eiv \
  -e '^[[:space:]]*Co-authored-by:[[:space:]].*(Cursor|cursoragent@)' \
  -e '^[[:space:]]*Made-with:[[:space:]]*Cursor' \
  -e '^[[:space:]]*Made with Cursor' \
  -e '^[[:space:]]*Generated by[[:space:]].*(Cursor|Claude|Copilot|ChatGPT)' \
  -e '^[[:space:]]*Generated with[[:space:]].*(Cursor|Claude|Copilot|ChatGPT)' \
  "$msg_file" >"$tmp" || true

# Drop trailing blank lines left after stripping trailers
# (keep a single trailing newline)
awk '
  { lines[NR] = $0 }
  END {
    end = NR
    while (end > 0 && lines[end] ~ /^[[:space:]]*$/) end--
    for (i = 1; i <= end; i++) print lines[i]
  }
' "$tmp" >"$msg_file"
